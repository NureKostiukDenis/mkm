{
  "latex-workshop.latex.recipe.default": "latexmk (lualatex)",
  "editor.fontSize": 15,
  "editor.wordWrap": "on",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-lualatex",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "lualatex",
      "command": "lualatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": ["%DOCFILE%"]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (lualatex)",
      "tools": ["latexmk"]
    },
    {
      "name": "lualatex ➞ bibtex ➞ lualatex × 2",
      "tools": ["lualatex", "bibtex", "lualatex", "lualatex"]
    },
    {
      "name": "lualatex",
      "tools": ["lualatex"]
    }
  ]
}
